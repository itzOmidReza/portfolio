---
import "@fontsource-variable/vazirmatn";
import "@fontsource-variable/inter";
import Header from "../components/Header.astro";
import "../styles/global.css";

import { getLangFromUrl } from "../i18n/utils";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const dir = lang === "fa" ? "rtl" : "ltr";
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description ?? ""} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class:list={[lang === "fa" ? "font-vazir" : "font-inter"]}>
     <Header />
    <slot />
    <!--
  این بلوک رو داخل src/layouts/Layout.astro، درست قبل از بسته‌شدن </body>
  اضافه کن (اگه astro:transitions/ClientRouter داری، این اسکریپت با
  event "astro:page-load" هم دوباره اجرا می‌شه که بعد از ناوبری کار کنه).
-->
<script>
  function initScrollReveal() {
    const targets = document.querySelectorAll(
      ".reveal, .reveal-scale, .reveal-side, .reveal-side-end, .reveal-stagger"
    );
    if (!targets.length) return;

    // اگه کاربر انیمیشن کم می‌خواد، مستقیم همه رو نشون بده
    const prefersReduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    if (prefersReduced) {
      targets.forEach((el) => el.classList.add("is-visible"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target); // فقط یه بار انیمیت بشه
          }
        }
      },
      {
        threshold: 0.05, // زودتر تریگر بشه تا کل مسیر transition دیده بشه
        rootMargin: "0px 0px -15% 0px",
      }
    );

    // نکته‌ی مهم: اگه observer رو همون لحظه‌ی initScrollReveal() وصل کنیم،
    // برای المان‌هایی که از همون اول لود صفحه توی viewport هستن (مثل
    // StatsBar یا بالای About)، مرورگر فرصت نمی‌کنه state اولیه‌ی
    // opacity:0 رو یه فریم پینت کنه؛ در نتیجه IntersectionObserver فوراً
    // فایر میشه، کلاس is-visible همون لحظه اضافه میشه و transition
    // کامل skip میشه (پرش ناگهانی به‌جای fade نرم).
    // با دو تا requestAnimationFrame پشت‌سرهم مطمئن میشیم مرورگر حالت
    // اولیه رو واقعاً رندر کرده، بعد observer رو وصل می‌کنیم.
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        targets.forEach((el) => observer.observe(el));
      });
    });
  }

  // اجرای اولیه
  initScrollReveal();
  // اگه از View Transitions آسترو استفاده می‌کنی، بعد از هر ناوبری دوباره اجرا بشه
  document.addEventListener("astro:page-load", initScrollReveal);
</script>
  </body>
</html>