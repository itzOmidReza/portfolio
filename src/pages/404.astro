---
// src/pages/404.astro
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeHref = getRelativeLocaleUrl(lang, "/");
---

<Layout title={t("error.404.title")} description={t("error.404.description")}>
  <meta name="robots" content="noindex, follow" slot="head" />

  <section
    class="flex min-h-[70vh] flex-col items-center justify-center px-4 text-center"
  >
    <p class="font-heading text-7xl font-bold text-accent md:text-8xl">404</p>
    <h1 class="mt-4 font-heading text-2xl font-bold text-primary md:text-3xl">
      {t("error.404.heading")}
    </h1>
    <p class="mt-3 max-w-md text-text-muted">
      {t("error.404.body")}
    </p>
    <a
      href={homeHref}
      class="mt-8 rounded-(--radius-pill) bg-accent px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-primary"
    >
      {t("error.404.cta")}
    </a>
  </section>

  <Footer />
</Layout>
