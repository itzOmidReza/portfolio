---
// src/components/Experience.astro
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// هم‌الگوی Skills/Projects: پلیس‌هولدرهای ناقص با پیشوند TODO_ کنار گذاشته می‌شن
const experiences = (
  await getCollection("experience", ({ data }) => !data.company.startsWith("TODO_"))
).sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());

const typeLabels: Record<(typeof experiences)[number]["data"]["type"], string> = {
  freelance: t("experience.type.freelance"),
  contract: t("experience.type.contract"),
  education: t("experience.type.education"),
};
---

<section id="experience" class="py-(--spacing-section)">
  <div class="mx-auto max-w-4xl px-4">
    <h2 class="text-center font-heading text-3xl font-bold text-primary md:text-4xl">
      {t("section.experience")}
    </h2>

    <div class="relative mt-12 space-y-10 ps-10">
      <!-- خط اتصال‌دهنده‌ی عمودی -->
      <div class="absolute top-1 bottom-1 start-[15px] w-px bg-chip"></div>

      {
        experiences.map((exp) => (
          <div class="relative">
            <span class="absolute start-[-32px] top-1.5 h-3.5 w-3.5 rounded-full border-2 border-white bg-accent ring-4 ring-bg" />

            <div class="rounded-(--radius-card) bg-white p-6 shadow-sm">
              <div class="flex flex-wrap items-start justify-between gap-2">
                <div>
                  <h3 class="font-heading text-lg font-semibold text-primary">
                    {exp.data.role[lang]}
                  </h3>
                  <p class="mt-0.5 text-sm font-medium text-accent">
                    {exp.data.company}
                  </p>
                </div>

                <div class="flex flex-col items-end gap-1.5">
                  <span class="text-xs font-medium text-text-muted">
                    {exp.data.period}
                  </span>
                  <span class="rounded-(--radius-pill) bg-chip px-2.5 py-0.5 text-[11px] font-medium text-text-primary">
                    {typeLabels[exp.data.type]}
                  </span>
                </div>
              </div>

              <p class="mt-3 text-sm leading-relaxed text-text-muted">
                {exp.data.description[lang]}
              </p>

              <ul class="mt-4 flex flex-wrap gap-2">
                {exp.data.skills.map((skill) => (
                  <li class="rounded-(--radius-pill) bg-chip px-3 py-1 text-xs font-medium text-text-primary">
                    {skill}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>