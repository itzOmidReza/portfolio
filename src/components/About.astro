---
// src/components/About.astro
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { site } from "../i18n/site";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="about" class="py-(--spacing-section)">
  <div class="mx-auto max-w-4xl px-4">
    <h2 class="font-heading text-3xl font-bold text-primary md:text-4xl">
      {t("section.about")}
    </h2>

    <p class="mt-6 text-lg leading-relaxed text-text-muted">
      {site.bio.long[lang]}
    </p>

    <div class="mt-10 grid gap-8 md:grid-cols-2">
      <!-- در حال یادگیری -->
      <div class="rounded-(--radius-card) bg-white p-6 shadow-sm">
        <h3 class="font-heading text-lg font-semibold text-primary">
          {lang === "fa" ? "در حال یادگیری" : "Currently Learning"}
        </h3>
        <ul class="mt-4 space-y-2">
          {
            site.learning[lang].map((item) => (
              <li class="flex items-start gap-2 text-sm text-text-muted">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- دنبال چی هستم -->
      <div class="rounded-(--radius-card) bg-white p-6 shadow-sm">
        <h3 class="font-heading text-lg font-semibold text-primary">
          {lang === "fa" ? "دنبال چی هستم" : "What I'm Looking For"}
        </h3>
        <ul class="mt-4 space-y-2">
          {
            site.lookingFor[lang].map((item) => (
              <li class="flex items-start gap-2 text-sm text-text-muted">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
