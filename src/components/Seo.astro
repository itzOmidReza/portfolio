---
// src/components/Seo.astro
import { site as siteData } from "../i18n/site";
import { getLangFromUrl } from "../i18n/utils";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const base = Astro.site ?? new URL(Astro.url.origin);
const { title, description, ogImage } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const canonicalURL = new URL(Astro.url.pathname, base);

const finalDescription = description ?? siteData.bio.short[lang];

const ogImagePath = ogImage ?? `/og/default-${lang}.png`;
const ogImageURL = new URL(ogImagePath, base);
---

<link rel="alternate" hreflang="en" href={new URL("/", base)} />
<link rel="alternate" hreflang="fa" href={new URL("/fa/", base)} />
<link rel="alternate" hreflang="x-default" href={new URL("/", base)} />

<title>{title}</title>
<meta name="description" content={finalDescription} />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={finalDescription} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:locale" content={lang === "fa" ? "fa_IR" : "en_US"} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={finalDescription} />
<meta name="twitter:image" content={ogImageURL} />