---
// src/components/Footer.astro
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { site } from "../i18n/site";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const year = new Date().getFullYear();

const navItems = [
  { key: "nav.home", anchor: "#home" },
  { key: "nav.about", anchor: "#about" },
  { key: "nav.skills", anchor: "#skills" },
  { key: "nav.projects", anchor: "#projects" },
  { key: "nav.experience", anchor: "#experience" },
  { key: "nav.contact", anchor: "#contact" },
] as const;

const socials = [
  { icon: "simple-icons:github", href: site.contact.github, label: "GitHub" },
  { icon: "simple-icons:linkedin", href: site.contact.linkedin, label: "LinkedIn" },
  { icon: "simple-icons:telegram", href: site.contact.telegram, label: "Telegram" },
] as const;
---

<footer class="bg-dark py-12 text-white">
  <div class="mx-auto max-w-6xl px-4">
    <div class="flex flex-col items-center gap-6 md:flex-row md:items-start md:justify-between">
      <div class="text-center md:text-start">
        <p class="font-heading text-lg font-bold">{site.name}</p>
        <p class="mt-1 text-sm text-white/60">{site.role[lang]}</p>
      </div>

      <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2">
        {
          navItems.map((item) => (
            <a
              href={item.anchor}
              class="text-sm text-white/60 transition-colors hover:text-accent-light"
            >
              {t(item.key)}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-4">
        {
          socials.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.label}
              class="text-white/60 transition-colors hover:text-accent-light"
            >
              <Icon name={social.icon} class="h-5 w-5" />
            </a>
          ))
        }
      </div>
    </div>

    <div class="mt-10 border-t border-white/10 pt-6 text-center text-xs text-white/40">
      &copy; {year} {site.name}. {t("footer.rights")}
    </div>
  </div>
</footer>