---
// src/components/TechStackStrip.astro
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";

const skills = await getCollection("skills");
---

<section class="bg-white py-12">
  <div class="mx-auto max-w-6xl px-4">
    <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
      {skills.map((skill) => (
        <div
          class="flex flex-col items-center gap-2 text-text-muted transition-colors hover:text-accent"
          title={skill.data.name}
        >
          <Icon name={`simple-icons:${skill.data.icon}`} class="h-8 w-8" />
          <span class="text-xs">{skill.data.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>