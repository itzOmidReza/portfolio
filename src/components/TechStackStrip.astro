---
// src/components/TechStackStrip.astro
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { brandColor } from "../lib/brand-colors";

const skills = await getCollection("skills");
---

<section class="bg-white py-12">
  <div class="mx-auto max-w-6xl px-4">
    <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
      {
        skills.map((skill, i) => (
          <div
            class="enter-icon flex flex-col items-center gap-2"
            style={`--brand: ${brandColor(skill.data.icon)}; animation-delay: ${Math.min(i, 22) * 40}ms`}
            title={skill.data.name}
          >
            <Icon
              name={`simple-icons:${skill.data.icon}`}
              class="h-8 w-8 [color:var(--brand)]"
            />
            <span class="text-xs [color:var(--brand)]">
              {skill.data.name}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>